{
  "name": "auralis-audio-midi",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Offline audio-to-MIDI transcription with a bundled pretrained music model and DSP engines.",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/core.test.mjs tests/upgrade.test.mjs tests/precision.test.mjs",
    "test:ai": "node tests/ai-smoke.mjs",
    "test:precision": "node tests/precision-smoke.mjs"
  },
  "dependencies": {
    "@spotify/basic-pitch": "1.0.1",
    "@tensorflow/tfjs": "3.21.0",
    "@wasm-audio-decoders/flac": "0.2.9",
    "@wasm-audio-decoders/ogg-vorbis": "0.1.20",
    "ogg-opus-decoder": "1.7.5",
    "mpg123-decoder": "1.0.3",
    "@tensorflow/tfjs-backend-wasm": "3.21.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "@tonejs/midi": "2.0.28"
  }
}
