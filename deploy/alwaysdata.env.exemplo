# No painel Web > Sites > Environment, defina os valores abaixo com SUA conta.
# Este arquivo é um exemplo, não é carregado automaticamente.
MIDISHARE_PUBLIC_ORIGIN=https://SUA-CONTA.alwaysdata.net
MIDISHARE_DATA=/home/SUA-CONTA/midishare-data

# O alwaysdata fornece IP e PORT ao programa. Não defina uma porta arbitrária.
# Opcionais: estes são os padrões para a hospedagem gratuita.
MIDISHARE_MAX_USERS=20
MIDISHARE_MAX_FILES=200
MIDISHARE_USER_MIB=32
MIDISHARE_TOTAL_MIB=256
MIDISHARE_UPLOAD_MIB=8
MIDISHARE_REGISTRATION_OPEN=1
